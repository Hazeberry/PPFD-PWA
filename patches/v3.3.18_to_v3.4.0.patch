+// v3.4.0: Zwei-Punkt-Kalibrierung. Aus bis zu zwei Referenzpunkten
+// ({raw:rawPPFDUncalibrated, ref:referenzPPFD}) eine affine Korrektur
+// bestimmen: ppfd = slope*raw + offset. Ein Punkt => offset 0 (bisheriges
+// Verhalten, reine Steigung). Zwei Punkte bei DEUTLICH unterschiedlicher
+// Helligkeit kompensieren erste Ordnung Sensor-/ISP-Nichtlinearitaet ueber
+// den Dynamikbereich. Hinweis: Ein abgedeckter Punkt ist als zweite Stuetze
+// nahezu wertlos - blackLevelLin wird bereits pixel-domain subtrahiert,
+// rawPPFD waere per Konstruktion ~0.
+// Guards: Mindestabstand der Rohwerte (CALIB2_MIN_SEP), Steigung > 0;
+// Verletzung => null (Aufrufer warnt und behaelt die alte Kalibrierung).
+const CALIB2_MIN_SEP=5;
+function computeCalib2(p1,p2){
+  if(!p1&&!p2) return null;
+  if(p1&&!p2){
+    if(!(p1.raw>0)||!(p1.ref>0)) return null;
+    return{slope:p1.ref/p1.raw,offset:0,points:1};
+  }
+  if(!p1) return computeCalib2(p2,null);
+  const dRaw=p2.raw-p1.raw;
+  if(Math.abs(dRaw)<CALIB2_MIN_SEP) return null;
+  const slope=(p2.ref-p1.ref)/dRaw;
+  if(!(slope>0)) return null;
+  return{slope:slope,offset:p1.ref-slope*p1.raw,points:2};
+}
